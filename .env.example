# Together AI key (required — used for image generation)
# Get one at https://www.together.ai
# TOGETHER_API_KEY=tgp_v1_xxxxxxxxxxxxxxxxxxxxx

# Anthropic API key (required — used for prompt generation)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Image model (optional, default: black-forest-labs/FLUX.1-schnell)
# IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# LLM model for prompt generation (optional, default: anthropic:claude-haiku-4-5)
# AI_MODEL=anthropic:claude-haiku-4-5

# Default tracks directory (optional — CLI args override)
# PAINCAVE_TRACKS_DIR=/path/to/paincave/tracks
